# Copy this file to `.env` or `.env.local` and fill in real values.
# Never commit `.env` or `.env.local`.

DATABASE_URL="postgresql://postgres:password@localhost:5432/habari_connect_ai"
OPENAI_API_KEY="your_openai_api_key_here"
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth / SMS
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
SMS_API_KEY=""

# Habari company calendar (Google Sheets)
# Spreadsheet: https://docs.google.com/spreadsheets/d/1joCauwV7mPztYtFkLDwE126NHEYgnibCLFFQUq09_7E/edit?gid=0#gid=0
GOOGLE_CALENDAR_SHEET_ID="1joCauwV7mPztYtFkLDwE126NHEYgnibCLFFQUq09_7E"
# Leave blank to use the first worksheet
GOOGLE_CALENDAR_SHEET_NAME=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the private key with literal \n for newlines, e.g.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Server-side cache TTL in seconds (default 300 = 5 minutes)
CALENDAR_CACHE_SECONDS="300"

# Office network access (server-side only — never use NEXT_PUBLIC_)
# Comma-separated public IPv4/IPv6 addresses and/or CIDR ranges of Habari offices.
# Example: OFFICE_IP_ALLOWLIST="196.10.20.30,102.40.50.0/24"
# Do NOT use private Wi-Fi addresses (192.168.x.x / 10.x.x.x).
OFFICE_IP_ALLOWLIST=""
# Reserved for future audited emergency access (VPN / identity-aware proxy). Do not put in URLs.
OFFICE_NETWORK_BYPASS_SECRET=""
# Allow localhost during local development only (ignored in production)
ALLOW_LOCAL_DEVELOPMENT="true"

# AI chat rate limit per office public IP (shared by everyone on that egress)
AI_RATE_LIMIT_REQUESTS="30"
AI_RATE_LIMIT_WINDOW_SECONDS="600"

# People & Culture — profiles stay "new starters" for this many days after startDate
# (manual isNewStarter checkbox still overrides / can force the label on)
NEW_STARTER_DAYS="60"
